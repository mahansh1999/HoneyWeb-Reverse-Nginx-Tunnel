# HoneyWeb Reverse Nginx Tunnel {{NAME}}: an ordinary website with the tunnel behind it. Generated by rnt.sh.
include {{AUTH}};

server {
    # backlog: the kernel default (511 here) overflows under a burst of new connections (SYN cookies)
    listen {{LISTEN}} ssl backlog=4096;
    server_name {{DOMAIN}};
    server_tokens off;

    ssl_certificate     {{CERT}};
    ssl_certificate_key {{KEY}};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:rnt_{{NAME}}:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    # No http2 on purpose: the tunnel and the routed WebSocket paths are HTTP/1.1 upgrades, and offering only
    # http/1.1 lets a Chrome-shaped ClientHello (which offers h2 too) settle on http/1.1 in one handshake.

    root {{ROOT}};
    index index.html;
    charset utf-8;
    client_max_body_size 1m;
    client_header_timeout 15s;
    keepalive_timeout 65s;

    # The tunnel. Without the token these paths answer exactly as any missing page does.
    location = /channel {
        if ($rnt_{{NAME}}_ok = 0) { return 404; }
        proxy_pass http://127.0.0.1:{{BACKEND}};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_connect_timeout 5s;
        proxy_send_timeout 1d;
        proxy_read_timeout 1d;
        proxy_buffering off;
        # An upgraded connection relays through buffers of proxy_buffer_size; the default 4-8k costs throughput.
        # nginx -t also wants proxy_buffers big enough for the busy size, even with buffering off.
        proxy_buffer_size 64k;
        proxy_buffers 4 64k;
        proxy_busy_buffers_size 128k;
        proxy_socket_keepalive on;
        access_log off;
    }
    location ^~ /tunnel/ {
        if ($rnt_{{NAME}}_ok = 0) { return 404; }
        proxy_pass http://127.0.0.1:{{BACKEND}};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_connect_timeout 5s;
        proxy_send_timeout 1d;
        proxy_read_timeout 1d;
        proxy_buffering off;
        proxy_buffer_size 64k;
        proxy_buffers 4 64k;
        proxy_busy_buffers_size 128k;
        proxy_socket_keepalive on;
        access_log off;
    }

    # WebSocket paths of the site handed into the tunnel (rnt.sh --route).
{{ROUTES}}
    # The website.
    location / {
        try_files $uri $uri/ =404;
    }
    location = /favicon.ico { log_not_found off; access_log off; }
}

{{HTTP_SERVER}}
