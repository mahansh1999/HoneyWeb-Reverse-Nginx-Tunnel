# HoneyWeb Reverse Nginx Tunnel {{NAME}} (direct): an ordinary website whose WebSocket paths NGINX itself carries to
# the exit's NGINX over TLS. No tunnel engine, no iptables. Generated by rnt.sh.
server {
    # backlog: the kernel default (511 here) overflows under a burst of new connections (SYN cookies)
    listen {{LISTEN}} ssl backlog=4096;
    server_name {{DOMAIN}};
    server_tokens off;

    ssl_certificate     {{CERT}};
    ssl_certificate_key {{KEY}};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:rnt_{{NAME}}:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    root {{ROOT}};
    index index.html;
    charset utf-8;
    client_max_body_size 1m;
    client_header_timeout 15s;
    keepalive_timeout 65s;

    # WebSocket paths carried to the exit (rnt.sh direct --route).
{{ROUTES}}
    # The website.
    location / {
        try_files $uri $uri/ =404;
    }
    location = /favicon.ico { log_not_found off; access_log off; }
}

{{HTTP_SERVER}}
