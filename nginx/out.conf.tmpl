# HoneyWeb Reverse Nginx Tunnel {{NAME}}: the exit's way out (generated by rnt.sh). The engine (wsmux) speaks
# plain HTTP to this loopback-only server; NGINX carries every upgraded connection to the entry's website over
# TLS, naming the site in SNI and Host and refusing any certificate the CA bundle does not vouch for (an impostor
# in the middle would otherwise receive the token). On the wire this is one NGINX visiting another's site.
server {
    listen 127.0.0.1:{{LISTEN_PORT}};
    server_tokens off;
    access_log off;

    location / {
        proxy_pass https://{{UPSTREAM}};
        proxy_http_version 1.1;
        proxy_set_header Host {{DOMAIN}};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_ssl_server_name on;
        proxy_ssl_name {{DOMAIN}};
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 4;
        proxy_ssl_trusted_certificate {{CA}};
        proxy_ssl_session_reuse on;
{{BIND}}
        proxy_connect_timeout 10s;
        proxy_send_timeout 1d;
        proxy_read_timeout 1d;
        proxy_buffering off;
        # An upgraded connection relays through buffers of proxy_buffer_size; the default 4-8k costs throughput.
        proxy_buffer_size 64k;
        proxy_buffers 4 64k;
        proxy_busy_buffers_size 128k;
        proxy_socket_keepalive on;
    }
}
